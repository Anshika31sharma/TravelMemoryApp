// Travel Memory Map - Database Schema
// MySQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== USER ====================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips Trip[]

  @@map("users")
}

// ==================== TRIP ====================
model Trip {
  id          String   @id @default(cuid())
  userId      String
  country     String
  city        String
  latitude    Float
  longitude   Float
  startDate   DateTime
  endDate     DateTime
  description String?  @db.Text
  totalExpense Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripDays TripDay[]
  photos   Photo[]
  tripTags TripTag[]

  @@index([userId])
  @@index([country, city])
  @@index([startDate])
  @@map("trips")
}

// ==================== TRIP DAY (Day-wise memories) ====================
model TripDay {
  id        String   @id @default(cuid())
  tripId    String
  dayNumber Int      // 1, 2, 3... for each day of the trip
  date      DateTime
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, dayNumber])
  @@index([tripId])
  @@map("trip_days")
}

// ==================== PHOTO ====================
model Photo {
  id        String   @id @default(cuid())
  tripId    String
  filename  String   // stored filename (e.g., uuid-originalname.jpg)
  originalName String
  caption   String?
  order     Int      @default(0) // for ordering in gallery
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("photos")
}

// ==================== TAG (solo, friends, family, work, etc.) ====================
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "solo", "friends", "family", "work"
  createdAt DateTime @default(now())

  tripTags TripTag[]

  @@map("tags")
}

// ==================== TRIP-TAG (Many-to-Many) ====================
model TripTag {
  id     String @id @default(cuid())
  tripId String
  tagId  String

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tripId, tagId])
  @@index([tripId])
  @@index([tagId])
  @@map("trip_tags")
}
